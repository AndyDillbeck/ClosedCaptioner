<Window x:Class="MainWindow"
        x:Name="MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Images/closed_caption_77454.png"
    Title="Closed Captioner" Height="796" Width="873">
    <Grid Name="grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="275*" />
            <RowDefinition Height="58" />
            <RowDefinition Height="200" />
            <RowDefinition Height="224*" />
        </Grid.RowDefinitions>
        <MediaElement Grid.Row="0" Name="VideoWindow" LoadedBehavior="Manual" />

        <Slider Grid.Row="1" Height="23" Margin="12,4,120,0" Name="SeekBar" VerticalAlignment="Top" Thumb.DragStarted="SeekBar_DragStarted" Thumb.DragCompleted="SeekBar_DragCompleted" />
        <TextBlock Grid.Row="1" Height="23" HorizontalAlignment="Right" Margin="0,4,6,0" Name="txtPosition" VerticalAlignment="Top" Width="108" />
        
        <Button Content="Load Video" Grid.Row="1" Height="23" HorizontalAlignment="Left" Margin="12,29,0,0" Name="cmdLoad" VerticalAlignment="Top" Width="75" />
        <Button Content="Back" Grid.Row="1" Height="23" HorizontalAlignment="Left" Margin="110,29,0,0" Name="cmdBack" VerticalAlignment="Top" Width="50" />
        <Button Content="Play" Grid.Row="1" Height="23" HorizontalAlignment="Left" Margin="166,29,0,0" Name="cmdPlay" VerticalAlignment="Top" Width="50" />
        <Button Content="Forward" Grid.Row="1" Height="23" HorizontalAlignment="Left" Margin="222,29,0,0" Name="cmdForward" VerticalAlignment="Top" Width="50" />
        <Button Content="Start" Grid.Row="1" Height="23" HorizontalAlignment="Left" Margin="421,29,0,0" Name="cmdIn" VerticalAlignment="Top" Width="49" />
        <Button Content="End" Grid.Row="1" Height="23" HorizontalAlignment="Left" Margin="476,29,0,0" Name="cmdOut" VerticalAlignment="Top" Width="49" />
        <GroupBox Grid.Row="3" Header="Closed Captions" Name="GroupBox1">
            <Grid >
                <DataGrid AutoGenerateColumns="false" Name="dgCaptions" ItemsSource="{Binding ElementName=MainWindow, Path=cLineInfo}" CanUserDeleteRows="True" CanUserReorderColumns="False" GridLinesVisibility="Horizontal" Margin="0,0,0,0" Grid.ColumnSpan="3" AlternatingRowBackground="#FFFFE776">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Name="mnuDeleteLine" Header="Delete Line" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Start Time" Width="Auto" Binding="{Binding StartTime}" />
                        <DataGridTextColumn Header="End Time" Width="Auto" Binding="{Binding EndTime}" />
                        <DataGridTextColumn Header="Caption" Width="*" Binding="{Binding CaptionText}" >
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="AcceptsReturn" Value="true" />
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Link URL" Width="Auto" Binding="{Binding linkUrl}" />
                        <DataGridTextColumn Header="Link Text" Width="Auto" Binding="{Binding linkText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
            <Canvas Name="waveform" >
                <!--<ItemsControl Name="RectArea">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Stroke="Yellow" Fill="Yellow" Opacity="0.2" Height="200" Width="{Binding Width}" Canvas.Left="{Binding Left,Converter={StaticResource TtoX}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>-->
            </Canvas>
        </ScrollViewer>
        <Button Content="Export WebVTT" Grid.Row="1" Height="23" HorizontalAlignment="Right" Margin="0,29,6,0" Name="cmdExport" VerticalAlignment="Top" Width="108" />
        <Button Content="Open CC" Grid.Row="1" Height="23" HorizontalAlignment="Right" Margin="0,29,120,0" Name="cmdOpenCC" VerticalAlignment="Top" Width="75" />
    </Grid>
</Window>
